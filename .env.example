# Copy to .env for local development. Never commit .env.

# Django
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (read by both the db container and Django)
POSTGRES_DB=dropline
POSTGRES_USER=dropline
POSTGRES_PASSWORD=dropline
POSTGRES_HOST=db
POSTGRES_PORT=5432
